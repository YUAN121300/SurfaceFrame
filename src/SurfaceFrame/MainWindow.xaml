<Window x:Class="SurfaceFrame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SurfaceFrame"
        Title="SurfaceFrame"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        WindowState="Normal"
        Topmost="True"
        ShowInTaskbar="True"
        Background="Black"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="20"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Stylus.IsPressAndHoldEnabled="False"
        Stylus.IsFlicksEnabled="False"
        Stylus.IsTapFeedbackEnabled="False">
    <Grid>
        <!-- Screen 1: Full-screen Photos + Dual-Portrait + Muted Live Photo Overlay -->
        <Grid x:Name="PhotoLayer" ClipToBounds="True" Background="Black">
            <local:CenterFillPanel x:Name="SinglePhotoHost" Crop="True">
                <Image x:Name="PhotoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Image x:Name="LivePhotoImage" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
            </local:CenterFillPanel>
            <Grid x:Name="SingleCaptionLayer" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,26">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="SingleCaptionCity" FontSize="26" FontWeight="SemiBold" Foreground="#FAFFFFFF" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="SingleCaptionDetail" FontSize="17" FontWeight="Medium" Foreground="#E6FFFFFF" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Width="3" CornerRadius="1.5" Background="#E0FFFFFF" Margin="0,3,0,3"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="DualPhotoHost" Visibility="Collapsed" Background="Black">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <local:CenterFillPanel x:Name="LeftPhotoHost" Grid.Column="0" Crop="True">
                    <Image x:Name="LeftPhotoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image x:Name="LeftLivePhotoImage" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                </local:CenterFillPanel>
                <Grid x:Name="LeftCaptionLayer" Grid.Column="0" Visibility="Collapsed" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="LeftCaptionCity" FontSize="21" FontWeight="SemiBold" Foreground="#FAFFFFFF" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="LeftCaptionDetail" FontSize="14.5" FontWeight="Medium" Foreground="#E6FFFFFF" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Width="2.5" CornerRadius="1.5" Background="#E0FFFFFF" Margin="0,2,0,2"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Column="1" Background="Black"/>
                <local:CenterFillPanel x:Name="RightPhotoHost" Grid.Column="2" Crop="True">
                    <Image x:Name="RightPhotoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image x:Name="RightLivePhotoImage" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                </local:CenterFillPanel>
                <Grid x:Name="RightCaptionLayer" Grid.Column="2" Visibility="Collapsed" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="RightCaptionCity" FontSize="21" FontWeight="SemiBold" Foreground="#FAFFFFFF" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="RightCaptionDetail" FontSize="14.5" FontWeight="Medium" Foreground="#E6FFFFFF" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Width="2.5" CornerRadius="1.5" Background="#E0FFFFFF" Margin="0,2,0,2"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <Border x:Name="AlbumStatusPill"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"
                    Padding="18,9"
                    CornerRadius="20"
                    Background="#CC0F172A"
                    Visibility="Collapsed">
                <TextBlock x:Name="AlbumStatusText"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="正在同步相册…"/>
            </Border>
            <TextBlock x:Name="EmptyHint"
                       Text="相册是空的。请将 JPEG 或 PNG 放到相册文件夹。"
                       Foreground="White"
                       FontSize="28"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="48"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- Screen 2: Daylight White HA Control Screen (3-finger swipe LEFT from Photos) -->
        <Grid x:Name="HaLayer" Visibility="Collapsed" Background="#F2F4F7">
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="HaHeaderHost" Grid.Row="0" Margin="24,10,24,4"/>
            <Grid Grid.Row="1" Margin="24,4,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="SceneBarRow" Height="76"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="146"/>
                </Grid.RowDefinitions>
                <UniformGrid x:Name="SceneBar" Grid.Row="0" Columns="5" Margin="0,0,0,8"/>
                <UniformGrid x:Name="LightsGrid" Grid.Row="1" Columns="4"/>
                <Grid x:Name="BottomControlRow" Grid.Row="2" Margin="0,8,0,0"/>
            </Grid>
        </Grid>

        <!-- Screen 3: Daylight White Bento Status Screen (3-finger swipe RIGHT from Photos) -->
        <Grid x:Name="InfoLayer" Visibility="Collapsed" Background="#F2F4F7">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="InfoHeaderHost" Grid.Row="0" Margin="24,12,24,6"/>
            <Grid x:Name="InfoBentoGrid" Grid.Row="1" Margin="24,6,24,20"/>
        </Grid>

        <!-- Album Picker Modal Overlay -->
        <Grid x:Name="AlbumPickerOverlay" Visibility="Collapsed" Background="#660F172A" Tag="album:close">
            <Border Width="620"
                    MaxHeight="660"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="24"
                    Tag="album:modal">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.18" Color="#0F172A"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                            <TextBlock x:Name="AlbumPickerTitle" Text="选择展示相册" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="AlbumPickerSub" Text="从 NAS Immich 或本地照片目录选择" FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Tag="album:close"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Width="40" Height="40"
                                CornerRadius="20"
                                Background="#F1F5F9">
                            <TextBlock Text="&#xE8BB;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="#475569"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="PinLockPanel" Grid.Row="1" Visibility="Collapsed">
                        <StackPanel x:Name="PinDotsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,10"/>
                        <TextBlock x:Name="PinErrorText" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#E11D48" MinHeight="20" Margin="0,0,0,14"/>
                        <UniformGrid x:Name="PinKeypadGrid" Columns="3" Width="348" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <ScrollViewer x:Name="AlbumListScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <StackPanel x:Name="AlbumListPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Away / Boot Black Shield -->
        <Grid x:Name="ShieldLayer" Background="Black" IsHitTestVisible="True">
            <TextBlock x:Name="ShieldText"
                       Foreground="#888888"
                       FontSize="28"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Demo Controls (Demo mode only) -->
        <Border x:Name="DemoHost"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="16"
                Padding="8"
                CornerRadius="16"
                Background="#E2E8F0"
                Visibility="Collapsed">
            <StackPanel x:Name="DemoBar" Orientation="Horizontal"/>
        </Border>
    </Grid>
</Window>
