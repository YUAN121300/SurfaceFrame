<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>SurfaceFrame</RootNamespace>
    <AssemblyName>SurfaceFrame</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SurfaceFrame.Core\SurfaceFrame.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\frame.example.json" Link="frame.example.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\frame.private.example.json" Link="frame.private.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
